# Copy this file to .env for local development
# Get your token from: https://vercel.com/account/tokens

# Multiple accounts: name:token:teamId, comma-separated (teamId optional for personal accounts)
VERCEL_ACCOUNTS=perso

# Or a single account (used only when VERCEL_ACCOUNTS is empty)
# VERCEL_TOKEN=your_vercel_token_here
# VERCEL_TEAM_ID=your_vercel_team_id_here
PORT=3000
NODE_ENV=development